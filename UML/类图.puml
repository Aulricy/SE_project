@startuml
title 二手交易平台类图
caption 业务实体、服务协作与枚举分区展示
top to bottom direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 55
skinparam defaultFontSize 15
skinparam ArrowFontSize 13
skinparam ArrowColor #64748B
skinparam PackageBorderColor #94A3B8
skinparam PackageBackgroundColor #F8FAFC
skinparam PackageFontStyle bold
skinparam PackageFontSize 18
skinparam ClassBorderColor #64748B
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor<<entity>> #DCFCE7
skinparam ClassHeaderBackgroundColor<<service>> #DBEAFE
skinparam ClassHeaderBackgroundColor<<DTO>> #F3E8FF
skinparam LegendBackgroundColor #F8FAFC
skinparam LegendBorderColor #94A3B8

hide empty members

package "① 业务实体与关联" as Domain {
class "用户\nUser" as User <<entity>> {
    - id: Long
    - username: String
    - passwordHash: String
    - role: UserRole
    - createdAt: DateTime
}

class "商品\nProduct" as Product <<entity>> {
    - id: Long
    - name: String [0..1]
    - category: ProductCategory [0..1]
    - price: Decimal [0..1]
    - description: String [0..1]
    - imagePath: String [0..1]
    - status: ProductStatus
    - createdAt: DateTime
    - publishedAt: DateTime [0..1]
    - latestRejectReason: String [0..1]
    - latestBlockReason: String [0..1]
    - version: Integer
}

class "预约\nReservation" as Reservation <<entity>> {
    - id: Long
    - reservedPrice: Decimal
    - status: ReservationStatus
    - createdAt: DateTime
    - confirmedAt: DateTime [0..1]
    - cancelledAt: DateTime [0..1]
    - completedAt: DateTime [0..1]
    - cancelReason: String [0..1]
    - version: Integer
}

class "操作日志\nOperationLog" as OperationLog <<entity>> {
    - id: Long
    - operationType: OperationType
    - operatedAt: DateTime
    - productStatusBefore: ProductStatus [0..1]
    - productStatusAfter: ProductStatus [0..1]
    - reservationStatusBefore: ReservationStatus [0..1]
    - reservationStatusAfter: ReservationStatus [0..1]
    - reason: String [0..1]
}

class "操作请求记录\nOperationRequestRecord" as OperationRequestRecord <<entity>> {
    - id: Long
    - requestKey: String
    - operationType: OperationType
    - requestFingerprint: String
    - createdAt: DateTime
}



' 方向只用于布局；所有对象关联与原设计保持一致。
User "1" -right- "0..*" Product : seller / 卖家
User "1" -down- "0..*" Reservation : buyer / 买家
User "0..1" -- "0..*" Reservation : cancelledBy / 取消人
Product "1" -down- "0..*" Reservation : product / 商品
User "1" -down- "0..*" OperationLog : operator / 操作人
Product "1" -- "0..*" OperationLog : product / 商品
Reservation "0..1" -down- "0..*" OperationLog : reservation / 预约
User "1" -- "0..*" OperationRequestRecord : operator / 请求人
Reservation "1" -right- "0..*" OperationRequestRecord : result / 预约

OperationLog -[hidden]right-> OperationRequestRecord
}

package "② 服务协作与查询结果" as Services {
' 完整方法签名（图中仅省略参数列表）
' + createDraft(actor: User, name: String [0..1], category: ProductCategory [0..1], price: Decimal [0..1], description: String [0..1], imagePath: String [0..1]): Product
' + updateDraft(actor: User, productId: Long, expectedVersion: Integer, name: String [0..1], category: ProductCategory [0..1], price: Decimal [0..1], description: String [0..1], imagePath: String [0..1]): Product
' + submitForReview(actor: User, productId: Long, expectedVersion: Integer): void
' + withdrawReview(actor: User, productId: Long, expectedVersion: Integer): void
' + approve(actor: User, productId: Long, expectedVersion: Integer): void
' + reject(actor: User, productId: Long, expectedVersion: Integer, reason: String): void
' + takeDown(actor: User, productId: Long, expectedVersion: Integer): void
' + returnToDraft(actor: User, productId: Long, expectedVersion: Integer): void
' + block(actor: User, productId: Long, expectedVersion: Integer, reason: String): void
' + restoreToDraft(actor: User, productId: Long, expectedVersion: Integer): void
' + searchProducts(keyword: String, category: ProductCategory, minPrice: Decimal, maxPrice: Decimal, page: Integer): List<Product>
' + listOwnProducts(actor: User, status: ProductStatus): List<Product>
' + listAllProducts(actor: User, status: ProductStatus): List<Product>
' + getDetail(actor: User [0..1], productId: Long): Product
class "商品服务\nProductService" as ProductService <<service>> {
    + createDraft(...): Product
    + updateDraft(...): Product
    + submitForReview(...): void
    + withdrawReview(...): void
    + approve(...): void
    + reject(...): void
    + takeDown(...): void
    + returnToDraft(...): void
    + block(...): void
    + restoreToDraft(...): void
    + searchProducts(...): List<Product>
    + listOwnProducts(...): List<Product>
    + listAllProducts(...): List<Product>
    + getDetail(...): Product
}

' 完整方法签名（图中仅省略参数列表）
' + reserve(actor: User, productId: Long, expectedVersion: Integer, requestKey: String): Reservation
' + confirm(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String): Reservation
' + cancel(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String, reason: String): Reservation
' + complete(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String): Reservation
' + listAsBuyer(actor: User): List<Reservation>
' + listAsSeller(actor: User): List<Reservation>
' + getDetail(actor: User, reservationId: Long): Reservation
' ~ cancelForBlocking(actor: User, product: Product, reason: String): void
class "预约服务\nReservationService" as ReservationService <<service>> {
    + reserve(...): Reservation
    + confirm(...): Reservation
    + cancel(...): Reservation
    + complete(...): Reservation
    + listAsBuyer(...): List<Reservation>
    + listAsSeller(...): List<Reservation>
    + getDetail(...): Reservation
    ~ cancelForBlocking(...): void
}

' 完整方法签名（图中仅省略参数列表）
' ~ record(log: OperationLog): void
' + query(actor: User, startTime: DateTime, endTime: DateTime, operatorId: Long, productId: Long, reservationId: Long, operationType: OperationType): List<OperationLog>
class "日志服务\nLogService" as LogService <<service>> {
    ~ record(...): void
    + query(...): List<OperationLog>
}

' 完整方法签名（图中仅省略参数列表）
' + register(username: String, password: String): User
' + login(username: String, password: String): User
' + createAdmin(operator: User, username: String, password: String): User
' + requireLogin(): User
' + requireAdmin(actor: User): void
' + requireInitialAdmin(actor: User): void
' + requireOwner(actor: User, owner: User): void
class "用户服务\nUserService" as UserService <<service>> {
    - initialAdminId: Long {readOnly}
    + register(...): User
    + login(...): User
    + createAdmin(...): User
    + requireLogin(...): User
    + requireAdmin(...): void
    + requireInitialAdmin(...): void
    + requireOwner(...): void
}

' 完整方法签名（图中仅省略参数列表）
' + getCompletedStatistics(actor: User, startDate: Date, endDate: Date): StatisticsResult
class "统计服务\nStatisticsService" as StatisticsService <<service>> {
    + getCompletedStatistics(...): StatisticsResult
}


ProductService .right.> ReservationService : 屏蔽联动取消
ProductService .down.> UserService : 鉴权
ReservationService .down.> UserService : 鉴权
ProductService ..> LogService : 记日志
ReservationService .down.> LogService : 记日志
LogService .left.> UserService : 查询鉴权
StatisticsService .up.> UserService : 管理员鉴权

class "统计结果\nStatisticsResult" as StatisticsResult <<DTO>> {
    - startDate: Date
    - endDate: Date
    - completedCount: Long
    - totalAmount: Decimal
}

UserService -[hidden]down-> StatisticsService
StatisticsService .down.> StatisticsResult : 生成
}

package "③ 枚举与取值" as Types {
enum "用户角色\nUserRole" as UserRole {
    MEMBER
    ADMIN
}

enum "商品分类\nProductCategory" as ProductCategory {
    DIGITAL
    BOOKS
    DAILY_NECESSITIES
    CLOTHING
    OTHER
}

enum "商品状态\nProductStatus" as ProductStatus {
    DRAFT
    PENDING_REVIEW
    PUBLISHED
    RESERVED
    CONFIRMED
    COMPLETED
    OFF_SHELF
    BLOCKED
}

enum "预约状态\nReservationStatus" as ReservationStatus {
    PENDING_CONFIRMATION
    CONFIRMED
    CANCELLED
    COMPLETED
}

enum "操作类型\nOperationType" as OperationType {
    SUBMIT_REVIEW
    WITHDRAW_REVIEW
    APPROVE_REVIEW
    REJECT_REVIEW
    TAKE_DOWN
    RETURN_TO_DRAFT
    BLOCK_PRODUCT
    RESTORE_TO_DRAFT
    CREATE_RESERVATION
    CONFIRM_RESERVATION
    CANCEL_RESERVATION
    COMPLETE_TRANSACTION
}


UserRole -[hidden]right-> ProductCategory
ProductCategory -[hidden]right-> ProductStatus
ProductStatus -[hidden]right-> ReservationStatus
ReservationStatus -[hidden]right-> OperationType
}

Product -[hidden]right-> ProductService
OperationLog -[hidden]down-> UserRole
StatisticsResult -[hidden]down-> UserRole

legend bottom left
  <b>阅读说明</b>
  实线表示关联，端点数字表示多重性；虚线箭头表示服务依赖。
  0..1：零个或一个；0..*：零个或多个；-：私有；+：公开；~：模块内部。
  方法中的 (...) 表示省略参数，完整签名保存在源文件注释中。
  枚举引用已通过属性类型表达，不再重复绘制连线。

  <b>跨分区的数据使用关系</b>
  | 服务 | 使用的实体或结果 |
  | UserService | 创建、验证 User |
  | ProductService | 管理 Product |
  | ReservationService | 管理 Reservation、联动更新 Product、保存 OperationRequestRecord |
  | StatisticsService | 读取已完成 Reservation，生成 StatisticsResult |
  | LogService | 保存、只读查询 OperationLog |

  <b>关键约束</b>
  1. username 唯一；密码以带盐哈希保存。同一普通账号可以同时作为买家和卖家。
     普通注册仅创建 MEMBER；首个管理员预置。
     initialAdminId 从配置读取；createAdmin 须通过 requireInitialAdmin 检查，限定首个管理员授权设置。
  2. createDraft 创建草稿，由系统设置卖家、编号、初始状态及版本；updateDraft 仅修改本人草稿。
     两者只接收商品填写字段；草稿可不完整，提交审核时检查必填项，价格须大于 0 且最多两位小数。
     商品至多一张图片；成色、联系方式和交付说明均放在 description 中。
  3. 同一商品允许多条历史预约，但待确认或已确认的有效预约合计最多一条；不得预约本人商品。
  4. reservedPrice 保存预约时价格；completedAt 仅首次完成时写入；新预约不覆盖历史预约。
  5. 已预约、已确认商品不能直接修改或下架；已完成商品不能重发；屏蔽后仅管理员可恢复为草稿。
     最近一次驳回、屏蔽原因保存在 Product；完整处理历史保存在 OperationLog。
     publishedAt 建议记录最近一次审核通过的发布时间。
  6. 商品、预约、成功请求记录和关键日志在同一业务事务中保存。
     普通取消释放商品为已发布；屏蔽联动取消时商品保持已屏蔽。
  7. updateDraft 及商品提交、撤回、审核、下架、退回草稿、屏蔽、恢复均接收 expectedVersion 检查商品版本。
     预约检查商品版本；确认、取消、完成检查预约版本，版本检查与更新须原子执行。
     成功改变状态时递增相应版本；cancelForBlocking 仅供模块内部协作。
  8. 成功请求的“操作人 + requestKey”唯一；同标识同内容返回原预约及当前状态，不重复执行。
     同标识不同内容拒绝；新操作使用新标识；请求记录持久保存。
  9. 统计仅面向管理员，按首次完成的北京时间归属日期，包含起止两天；起始日期不得晚于结束日期。
     每条已完成预约仅计一次，金额汇总 reservedPrice；无记录时均为 0；StatisticsResult 不单独持久化。
  10. 日志关联操作人、商品及可选预约，保留前后状态和适用原因；不记录密码，仅管理员只读查询。
      查询筛选条件按需填写，并检查数据访问范围；所有受限业务操作均须鉴权。
endlegend

' 本次仅调整草稿方法、商品版本检查、首个管理员权限；调整前文件见 ../工作资料/设计历史/三项调整前/。
@enduml
