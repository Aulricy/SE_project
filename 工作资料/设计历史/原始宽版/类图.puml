@startuml
title 二手交易平台类图

top to bottom direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50

hide empty members

' ==================== 用户与权限模块 ====================

package "用户与权限模块" {

  class "用户\nUser" as User <<entity>> {
    - id: Long
    - username: String
    - passwordHash: String
    - role: UserRole
    - createdAt: DateTime
  }

  class "用户服务\nUserService" as UserService <<service>> {
    + register(username: String, password: String): User
    + login(username: String, password: String): User
    + createAdmin(operator: User, username: String, password: String): User
    + requireLogin(): User
    + requireAdmin(actor: User): void
    + requireOwner(actor: User, owner: User): void
  }
}

' ==================== 商品管理模块 ====================

package "商品管理模块" {

  class "商品\nProduct" as Product <<entity>> {
    - id: Long
    - name: String [0..1]
    - category: ProductCategory [0..1]
    - price: Decimal [0..1]
    - description: String [0..1]
    - imagePath: String [0..1]
    - status: ProductStatus
    - createdAt: DateTime
    - publishedAt: DateTime [0..1]
    - latestRejectReason: String [0..1]
    - latestBlockReason: String [0..1]
    - version: Integer
  }

  class "商品服务\nProductService" as ProductService <<service>> {
    + saveDraft(actor: User, product: Product): Product
    + submitForReview(actor: User, productId: Long): void
    + withdrawReview(actor: User, productId: Long): void
    + approve(actor: User, productId: Long): void
    + reject(actor: User, productId: Long, reason: String): void
    + takeDown(actor: User, productId: Long): void
    + returnToDraft(actor: User, productId: Long): void
    + block(actor: User, productId: Long, reason: String): void
    + restoreToDraft(actor: User, productId: Long): void
    + searchProducts(keyword: String, category: ProductCategory, minPrice: Decimal, maxPrice: Decimal, page: Integer): List<Product>
    + listOwnProducts(actor: User, status: ProductStatus): List<Product>
    + listAllProducts(actor: User, status: ProductStatus): List<Product>
    + getDetail(actor: User [0..1], productId: Long): Product
  }
}

' ==================== 预约与交易模块 ====================

package "预约与交易模块" {

  class "预约\nReservation" as Reservation <<entity>> {
    - id: Long
    - reservedPrice: Decimal
    - status: ReservationStatus
    - createdAt: DateTime
    - confirmedAt: DateTime [0..1]
    - cancelledAt: DateTime [0..1]
    - completedAt: DateTime [0..1]
    - cancelReason: String [0..1]
    - version: Integer
  }

  class "预约服务\nReservationService" as ReservationService <<service>> {
    + reserve(actor: User, productId: Long, expectedVersion: Integer, requestKey: String): Reservation
    + confirm(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String): Reservation
    + cancel(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String, reason: String): Reservation
    + complete(actor: User, reservationId: Long, expectedVersion: Integer, requestKey: String): Reservation
    + listAsBuyer(actor: User): List<Reservation>
    + listAsSeller(actor: User): List<Reservation>
    + getDetail(actor: User, reservationId: Long): Reservation
    ~ cancelForBlocking(actor: User, product: Product, reason: String): void
  }

  class "操作请求记录\nOperationRequestRecord" as OperationRequestRecord <<entity>> {
    - id: Long
    - requestKey: String
    - operationType: OperationType
    - requestFingerprint: String
    - createdAt: DateTime
  }
}

' ==================== 交易统计模块 ====================

package "交易统计模块" {

  class "统计服务\nStatisticsService" as StatisticsService <<service>> {
    + getCompletedStatistics(actor: User, startDate: Date, endDate: Date): StatisticsResult
  }

  class "统计结果\nStatisticsResult" as StatisticsResult <<DTO>> {
    - startDate: Date
    - endDate: Date
    - completedCount: Long
    - totalAmount: Decimal
  }
}

' ==================== 操作日志模块 ====================

package "操作日志模块" {

  class "操作日志\nOperationLog" as OperationLog <<entity>> {
    - id: Long
    - operationType: OperationType
    - operatedAt: DateTime
    - productStatusBefore: ProductStatus [0..1]
    - productStatusAfter: ProductStatus [0..1]
    - reservationStatusBefore: ReservationStatus [0..1]
    - reservationStatusAfter: ReservationStatus [0..1]
    - reason: String [0..1]
  }

  class "日志服务\nLogService" as LogService <<service>> {
    ~ record(log: OperationLog): void
    + query(actor: User, startTime: DateTime, endTime: DateTime, operatorId: Long, productId: Long, reservationId: Long, operationType: OperationType): List<OperationLog>
  }
}

' ==================== 枚举类型 ====================

package "枚举类型" {

  enum "用户角色\nUserRole" as UserRole {
    MEMBER
    ADMIN
  }

  enum "商品分类\nProductCategory" as ProductCategory {
    DIGITAL
    BOOKS
    DAILY_NECESSITIES
    CLOTHING
    OTHER
  }

  enum "商品状态\nProductStatus" as ProductStatus {
    DRAFT
    PENDING_REVIEW
    PUBLISHED
    RESERVED
    CONFIRMED
    COMPLETED
    OFF_SHELF
    BLOCKED
  }

  enum "预约状态\nReservationStatus" as ReservationStatus {
    PENDING_CONFIRMATION
    CONFIRMED
    CANCELLED
    COMPLETED
  }

  enum "操作类型\nOperationType" as OperationType {
    SUBMIT_REVIEW
    WITHDRAW_REVIEW
    APPROVE_REVIEW
    REJECT_REVIEW
    TAKE_DOWN
    RETURN_TO_DRAFT
    BLOCK_PRODUCT
    RESTORE_TO_DRAFT
    CREATE_RESERVATION
    CONFIRM_RESERVATION
    CANCEL_RESERVATION
    COMPLETE_TRANSACTION
  }
}

' ==================== 实体关联 ====================

User "1" -- "0..*" Product : seller / 所属卖家

User "1" -- "0..*" Reservation : buyer / 预约买家

Product "1" -- "0..*" Reservation : product / 对应商品

User "0..1" -- "0..*" Reservation : cancelledBy / 取消人

User "1" -- "0..*" OperationLog : operator / 操作人

Product "1" -- "0..*" OperationLog : product / 涉及商品

Reservation "0..1" -- "0..*" OperationLog : reservation / 涉及预约

User "1" -- "0..*" OperationRequestRecord : operator / 请求发起人

Reservation "1" -- "0..*" OperationRequestRecord : result / 对应预约

' ==================== 服务依赖 ====================

UserService ..> User : 创建、验证

ProductService ..> Product : 管理
ProductService ..> UserService : 检查身份与权限
ProductService ..> ReservationService : 屏蔽时联动取消预约
ProductService ..> LogService : 记录关键操作

ReservationService ..> Reservation : 管理
ReservationService ..> Product : 检查并联动更新
ReservationService ..> OperationRequestRecord : 识别重复请求
ReservationService ..> UserService : 检查身份与权限
ReservationService ..> LogService : 记录关键操作

StatisticsService ..> Reservation : 查询已完成预约
StatisticsService ..> StatisticsResult : 生成
StatisticsService ..> UserService : 检查管理员权限

LogService ..> OperationLog : 写入、只读查询
LogService ..> UserService : 检查查询权限

' ==================== 类型依赖 ====================

User ..> UserRole
Product ..> ProductCategory
Product ..> ProductStatus
Reservation ..> ReservationStatus
OperationLog ..> OperationType
OperationRequestRecord ..> OperationType

' ==================== 约束与设计说明 ====================

note left of User
  username 唯一。
  普通注册只能创建 MEMBER。
  首个管理员预置；
  后续管理员设置须获首个管理员批准。

  同一普通账号可以同时作为买家和卖家，
  由商品、预约关联确定具体业务身份。
  passwordHash 使用带盐的密码哈希格式。
end note

note right of Product
  一条商品记录代表一件商品，不管理库存数量。
  草稿允许信息不完整。
  提交审核时检查名称、分类、描述和价格；
  价格须大于 0，且最多两位小数。

  imagePath 最多对应一张图片。
  联系方式、成色和交付说明写在 description 中。
  publishedAt 建议记录最近一次审核通过的时间。

  已预约、已确认商品不能直接修改或下架。
  已完成商品不能重新发布。
  已屏蔽商品只能由管理员恢复为草稿。
end note

note right of Reservation
  buyer 不能等于 product.seller。

  同一商品可有多条历史预约，
  但待确认或已确认预约合计最多一条。

  reservedPrice 保存预约时的商品价格，
  不随商品后续改价而改变。

  completedAt 仅在首次成功完成时写入。
  取消须保存取消人、原因和时间。
  取消后重新预约须建立新记录。
end note

note bottom of ReservationService
  expectedVersion：
  预约时检查商品版本；
  确认、取消、完成时检查预约版本。

  检查版本与更新状态必须原子执行，
  成功改变状态时递增相应版本。

  商品、预约、成功请求记录和关键日志
  在同一业务事务内保存。

  普通取消后商品恢复已发布；
  屏蔽联动取消后商品保持已屏蔽。

  cancelForBlocking 为内部协作方法，
  不作为普通用户可直接调用的取消入口。
end note

note bottom of OperationRequestRecord
  只记录成功处理的预约、确认、取消、完成请求。
  “操作人 + requestKey”唯一。

  相同请求标识且内容一致：
  返回原预约及其当前状态，不重复执行。

  相同请求标识但内容不同：拒绝。
  明确发起新操作时使用新请求标识。
  请求记录持久保存，重启后仍可识别。
end note

note right of StatisticsResult
  查询起始日期不得晚于结束日期。
  按首次成功完成的北京时间归属日期，
  包含起止两天。

  只统计已完成预约，每条计入一次。
  totalAmount 汇总 reservedPrice，
  不代表实际收款。
  无完成记录时笔数和金额均为 0。

  本类为查询结果，无需单独持久保存。
end note

note right of OperationLog
  记录成功操作的操作人、时间、
  对象、操作类型、前后状态和适用原因。

  商品与预约的联动操作可在同一日志中
  分别保存两者的前后状态。

  日志中不记录密码。
  仅管理员可查询全平台日志。
  不提供日志修改、删除功能。
end note

legend bottom
  <<entity>>：需要持久保存的业务对象或辅助记录
  <<service>>：处理业务流程的服务类
  <<DTO>>：承载查询结果的数据对象
  实线：对象之间的关联；虚线箭头：使用依赖
  0..1：可选的一个；0..*：零个或多个
  -：私有属性；+：公开操作；~：模块内部操作
  查询方法的筛选条件按需填写，并检查数据访问范围
endlegend

@enduml