Space=wrap;html=0;fillColor=#2563eb;strokeColor=#2563eb;strokeWidth=1;opacity=100;" vertex="1" parent="1"><mxGeometry x="837" y="541.1875" width="366" height="45" as="geometry"/></mxCell><mxCell id="33" value="登录" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#ffffff;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1006" y="553.484375" width="28" height="20.3" as="geometry"/></mxCell><mxCell id="34" value="还没有账号？ " style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#7a879b;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="953.0625" y="607.1875" width="81.859375" height="18.849999999999998" as="geometry"/></mxCell><mxCell id="35" value="创建账号" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#2563eb;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1034.921875" y="607.1875" width="52" height="18.849999999999998" as="geometry"/></mxCell><mxCell id="36" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf0f5;strokeColor=none;strokeWidth=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="837" y="649.984375" width="366" height="1" as="geometry"/></mxCell><mxCell id="37" value="普通用户与管理员使用同一登录入口，系统识别账号权限。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#929cad;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="837" y="671.984375" width="312" height="17.4" as="geometry"/></mxCell><mxCell id="38" value="交互演示：普通账号 chen_demo，管理员账号 admin_demo，密码均为 Demo123!。请勿输入真实密码。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;