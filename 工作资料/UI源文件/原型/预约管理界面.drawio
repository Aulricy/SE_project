;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="601.96875" width="384.625" height="18.849999999999998" as="geometry"/></mxCell><mxCell id="48" value="联系方式：示例微信号 demo_contact" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#657389;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="652.65625" width="222" height="18.849999999999998" as="geometry"/></mxCell><mxCell id="49" value="交付说明：双方自行约定面交地点，现场检查后线下付款。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#657389;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="678" width="338" height="18.849999999999998" as="geometry"/></mxCell><mxCell id="50" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf0f5;strokeColor=none;strokeWidth=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="151" y="719.34375" width="815" height="1" as="geometry"/></mxCell><mxCell id="51" value="预约价格按发起时记录，商品后续价格变化不会改写这条记录。联系与交付说明按卖家填写的商品描述展示，不产生线上付款。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#96a1b2;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="737.34375" width="672" height="17.4" as="geometry"/></mxCell><mxCell id="52" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#dce2ec;strokeWidth=1;opacity=100;" vertex="1" parent="1"><mxGeometry x="151" y="781.140625" width="102" height="40" as="geometry"/></mxCell><mxCell id="53" value="取消预约" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#435068;fontStyle=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x